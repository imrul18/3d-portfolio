# Production origin, used for canonical URLs, Open Graph, sitemap and robots.
# Alternatively set `url` in src/config/site.ts.
NEXT_PUBLIC_SITE_URL=

# Contact form (optional) — sends through the Aetherix mail API (the MailServer
# project, `POST /api/send-mail`). The form appears only when MAIL_API_URL and
# CONTACT_TO_EMAIL are set and `form.enabled` is true in src/config/contact.ts.
# Full endpoint URL, e.g. https://<your-mailserver-host>/api/send-mail
MAIL_API_URL=
# Where contact messages are delivered (your inbox).
CONTACT_TO_EMAIL=
# Optional: bearer key, if the mail API is put behind one.
MAIL_API_KEY=
# Optional: sender name and address. Without them the mail API uses its own
# defaults (no-reply@mail.weaetherix.com).
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
